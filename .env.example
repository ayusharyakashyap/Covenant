# --- PayPal sandbox (https://developer.paypal.com/dashboard/applications/sandbox) ---
# Leave empty to run with the built-in PayPal simulator.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: webhook id from the sandbox app's Webhooks section (events: PAYMENT.AUTHORIZATION.*, PAYMENT.CAPTURE.*, PAYMENT.PAYOUTS-ITEM.*)
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
CURRENCY=USD
PLATFORM_FEE_PERCENT=0

# --- Claude (https://console.anthropic.com) ---
# Leave empty to run with the transparent offline rules engine.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- App ---
PORT=8787
# Verifier confidence needed to release money without a human (0.5–0.99)
AUTO_RELEASE_THRESHOLD=0.8
# Optional, raises GitHub API limits for PR verification
GITHUB_TOKEN=
