# --- PayPal sandbox (https://developer.paypal.com/dashboard/applications/sandbox) ---
# Leave empty to run with the built-in PayPal simulator.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: webhook id from the sandbox app's Webhooks section (events: PAYMENT.AUTHORIZATION.*, PAYMENT.CAPTURE.*, PAYMENT.PAYOUTS-ITEM.*)
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
CURRENCY=USD
PLATFORM_FEE_PERCENT=0

# --- Claude (https://console.anthropic.com) ---
# Leave empty to run with the transparent offline rules engine.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- App ---
PORT=8787
# Verifier confidence needed to release money without a human (0.5–0.99)
AUTO_RELEASE_THRESHOLD=0.8
# Optional, raises GitHub API limits for PR verification
GITHUB_TOKEN=

# --- Kernel cloud browsers (https://dashboard.onkernel.com) ---
# When set, submitted website links are opened in a real browser; desktop + mobile screenshots go to the verifier.
KERNEL_API_KEY=

# --- Notifications (Zapier / Make / Slack workflow) ---
# Paste a Zapier "Webhooks by Zapier → Catch Hook" URL to get notified when money moves or a decision is needed.
NOTIFY_WEBHOOK_URL=
# Public URL of this deployment, used for links in notifications (e.g. https://covenant.onrender.com)
PUBLIC_URL=

# --- AG Studio (optional trial licence, removes the watermark) ---
AG_STUDIO_LICENSE=

# --- Production ---
# Secret for signing live-update tickets. Generated and stored in DATA_DIR if unset.
SESSION_SECRET=
# Set to 1 behind a load balancer / reverse proxy so client IPs and HTTPS are detected.
TRUST_PROXY=
# json (default in production) or pretty
LOG_FORMAT=
# Background verification workers per instance
WORKER_CONCURRENCY=4
# Set to 1 to enable "Add sample contracts" on the Money page (local demos only)
DEMO_TOOLS=

# --- Gemini (free tier, no card needed): https://aistudio.google.com/apikey ---
# If set, Covenant uses Gemini; set AI_PROVIDER=claude to force Claude when both keys exist.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AI_PROVIDER=
